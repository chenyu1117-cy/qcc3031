static inline unsigned src_sync_usec_to_sec_frac(unsigned usec)
{
    /* usec << (DAWTH-1-20) "normalizes" usec <= 1e6 */
    return 2 * frac_mult(usec << (DAWTH-1-20), FRACTIONAL(0.5 / (1.0e6 / (1<<20))));
