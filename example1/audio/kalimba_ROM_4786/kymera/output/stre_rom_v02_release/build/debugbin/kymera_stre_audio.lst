800631d0 <$M.iir_2ndStage_downsample.insufficient_data>:

insufficient_data:
      // r10 < 0 amount of insufficient input        
      // r5 is amount of input required per output  
      r4 = r5 + r10;  
800631d0:	cf 00 67 00 	r4 = r5 + r10;
      if Z jump done; 
800631d4:	08 00 00 dd 	if EQ jump $M.iir_2ndStage_downsample.done;
      r5 = r4;
800631d8:	0f 00 76 00 	r5 = r4 + Null;
      r8 = M[IIR_FUNCTION_LOCAL_VAR];	// IIR Function Pointer
800631dc:	fc ff a8 f1 	r8 = M[SP + -0x4];

800631e0 <$M.iir_2ndStage_downsample.read_input_end>:
      read_input_end:
          I2 = I3,      rMAC = M[I1,M0];                    // Get Input
800631e0:	0f 14 23 58 	I2 = I3 + Null, rMAC = M[I1,M0];
          call   r8;		                            // Handle IIR
800631e4:	0f 00 0a e0 	call r8;
          r5 = r5 - r9, M[I0,M0] = rMAC, M[I4,M0] = r1;     // IIR history y(n),  FIR history x(n)
800631e8:	b0 90 7b 22 	r5 = r5 - r9, M[I0,M0] = rMAC, M[I4,M0] = r1;
      if NZ jump read_input_end;
800631ec:	fd ff 10 dd 	if NE jump $M.iir_2ndStage_downsample.read_input_end;
      r4 = NULL - r10;
800631f0:	cf 00 60 20 	r4 = Null - r10;

800631f4 <$M.iir_2ndStage_downsample.done>:
done:

   // Update State
   SP = SP - 2*ADDR_PER_WORD;	// remove local variables
800631f4:	f8 ff 03 f1 	SP = SP + -8;
   I3=I2;
800631f8:	0f 00 32 58 	I3 = I2 + Null;
   pop I2;
800631fc:	00 00 25 f3 	pop I2;
   L0=NULL,    M[I2,M0]=r4;      // Partial input
80063200:	0f e8 c0 50 	L0 = Null + Null, M[I2,M0] = r4;
   r0=I0,      M[I2,M0]=r3;      // polyphase count
80063204:	0f d8 20 44 	r0 = Null + I0, M[I2,M0] = r3;
   r0=I4,      M[I2,M0]=r0;      // FIR History
80063208:	4f a8 20 44 	r0 = Null + I4, M[I2,M0] = r0;
   L4=NULL,    M[I2,M0]=r0;      // IIR History
8006320c:	0f a8 e0 50 	L4 = Null + Null, M[I2,M0] = r0;
   // Outputs
   //    r7 = output produced
   //    I2 = State Pointer (next filter)
   //    I3 = Config Pointer (next filter)
   //    M0    = MK1
   jump $pop_rLink_and_rts;
